PORT=3001
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/preloved_user_service"
JWT_ACCESS_SECRET=replace_with_secure_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
INTERNAL_SERVICE_SECRET=replace_with_secure_internal_service_secret
